# The Rails API this app talks to (config/routes.rb's /api/private/* namespace
# in sheng-mchongoano-web). No trailing slash.
VITE_API_BASE_URL=https://shengmtaa.com

# Firebase project config, same project as the existing Android app and
# the old CRA app used - copy these from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
